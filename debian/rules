#!/usr/bin/make -f

# The build is entirely delegated to the top-level Makefile, whose `install`
# target is the single source of truth for where every shipped file lands. That
# matters more than it sounds: `make install DESTDIR=...` into a scratch tree is
# how t/ and the QEMU harness check the file manifest without building a .deb.

%:
	dh $@

# dh_fixperms resets modes on everything outside the recognised bin directories
# to 0644. /usr/lib/proxmod/proxmod-exec is named by pveproxy's and pvedaemon's
# ExecStart=, so a 0644 wrapper is not a cosmetic defect — it is both daemons
# failing to start with a systemd error that says nothing about proxmod.
#
# This is the single most expensive mistake available in this file, which is why
# the override is explicit about each path rather than a blanket chmod -R.
#
# find rather than a glob: /usr/sbin is created by the install target and is
# still empty until proxmod-verify lands, and a glob that matches nothing would
# fail the build for no reason.
override_dh_fixperms:
	dh_fixperms
	find debian/proxmod/usr/lib/proxmod debian/proxmod/usr/sbin \
	    -maxdepth 1 -type f -print0 2>/dev/null | xargs -0 -r chmod 0755

# The trigger and the boot-time unit both converge the host themselves, and
# postinst calls proxmod-reapply directly. Letting debhelper additionally
# restart things would mean two mechanisms deciding when the daemons bounce.
override_dh_installsystemd:
	dh_installsystemd --no-restart-after-upgrade --no-stop-on-upgrade

# conf/proxmod.conf is a conffile on every host and it names
# /usr/share/doc/proxmod/extension-manifest.md. dh_compress would gzip anything
# in that directory over 4 KiB, and the administrator following the pointer
# would find nothing there. Man pages are still compressed: nobody types the
# path of one.
override_dh_compress:
	dh_compress -X.md

# dpkg-deb's default compressor is a property of the build host, not of this
# package: Debian trixie produces control.tar.xz/data.tar.xz, an Ubuntu host
# produces .zst, and lintian rejects the second as a malformed archive. That
# turns "does this package pass lint" into "what did you build it on", which is
# a question no gate should have to ask. Pinned to xz, which is what the archive
# expects and what CI would have produced anyway.
override_dh_builddeb:
	dh_builddeb -- -Zxz
